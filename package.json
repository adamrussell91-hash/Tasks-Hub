{
  "name": "tasks-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/copy-spa-fallback.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "generate:auth": "node scripts/generate-auth-secrets.mjs",
    "seed:blobs": "node scripts/seed-blobs.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@netlify/blobs": "9.1.2",
    "@types/d3-force": "^3.0.10",
    "d3-force": "^3.0.0",
    "happy-dom": "^17.4.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "typescript": "5.9.2",
    "vite": "7.1.2",
    "vitest": "3.2.4"
  }
}
